    {
      "id": "stack-false-report",
      "fixture": "stack",
      "category": "no_bug",
      "expect": "no_change",
      "task": "A user reports that Stack.pop() on an empty stack crashes with a bare IndexError instead of raising EmptyStackError. Investigate. If the report is wrong, do not change any code; explain your finding in the summary.",
      "reference_plan": [
        {
          "tool": "read_file",
          "args": {
            "path": "stack/core.py"
          }
        },
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "finish",
          "args": {
            "summary": "Report is incorrect: pop() already raises EmptyStackError."
