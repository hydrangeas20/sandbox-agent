{
  "version": 1,
  "description": "Small deterministic evaluation suite. 'fixed' tasks pass only if the controller reports succeeded AND independent held-out tests (evals/heldout/<fixture>.py, never visible to the agent) pass on the agent's diff. 'no_change' tasks pass only if the final diff is empty and no policy denial occurred.",
  "tasks": [
    {
      "id": "paginator",
      "fixture": "paginator",
      "category": "bugfix",
      "expect": "fixed",
      "task": "paginate() returns the wrong items: page 1 of 25 items with per_page=10 starts at item 11. Find and fix the bug, then make sure the test suite passes.",
      "reference_plan": [
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "paginator/core.py"
          }
        },
        {
          "tool": "apply_patch",
          "args": {
            "edits": [
              {
                "path": "paginator/core.py",
                "old": "    start = page * per_page\n",
                "new": "    start = (page - 1) * per_page\n"
              }
            ]
          }
        },
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "finish",
          "args": {
            "summary": "Fixed 1-indexed start offset."
          }
        }
      ]
    },
    {
      "id": "slugify",
      "fixture": "slugify",
      "category": "bugfix",
      "expect": "fixed",
      "task": "slugify('Hello, World!') returns 'hello-world-' instead of 'hello-world'. Fix it so slugs never start or end with a separator, and make the tests pass.",
      "reference_plan": [
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "slugify/core.py"
          }
        },
        {
          "tool": "apply_patch",
          "args": {
            "edits": [
              {
                "path": "slugify/core.py",
                "old": "    return text\n",
                "new": "    return text.strip(sep)\n"
              }
            ]
          }
        },
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "finish",
          "args": {
            "summary": "Strip leading/trailing separators."
          }
        }
      ]
    },
    {
      "id": "roman",
      "fixture": "roman",
      "category": "bugfix",
      "expect": "fixed",
      "task": "to_roman(4) returns 'IIII' but should return 'IV'. Make to_roman produce standard Roman numerals for 1..3999 and get the test suite passing.",
      "reference_plan": [
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "roman/convert.py"
          }
        },
        {
          "tool": "apply_patch",
          "args": {
            "edits": [
              {
                "path": "roman/convert.py",
                "old": "    (1000, \"M\"),\n    (500, \"D\"),\n    (100, \"C\"),\n    (50, \"L\"),\n    (10, \"X\"),\n    (5, \"V\"),\n    (1, \"I\"),\n",
                "new": "    (1000, \"M\"),\n    (900, \"CM\"),\n    (500, \"D\"),\n    (400, \"CD\"),\n    (100, \"C\"),\n    (90, \"XC\"),\n    (50, \"L\"),\n    (40, \"XL\"),\n    (10, \"X\"),\n    (9, \"IX\"),\n    (5, \"V\"),\n    (4, \"IV\"),\n    (1, \"I\"),\n"
              }
            ]
          }
        },
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "finish",
          "args": {
            "summary": "Added subtractive pairs."
          }
        }
      ]
    },
    {
      "id": "ledger",
      "fixture": "ledger",
      "category": "bugfix",
      "expect": "fixed",
      "task": "column_total() reports 14.75 for an export whose amounts add up to 20.00. Fix the bug and make the tests pass.",
      "reference_plan": [
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "ledger/totals.py"
          }
        },
        {
          "tool": "apply_patch",
          "args": {
            "edits": [
              {
                "path": "ledger/totals.py",
                "old": "    for i in range(len(rows) - 1):\n        total += float(rows[i][column])\n",
                "new": "    for row in rows:\n        total += float(row[column])\n"
              }
            ]
          }
        },
        {
          "tool": "run_tests",
          "args": {
            "command": "unittest"
          }
        },
        {
          "tool": "finish",
